<Page x:Class="JamLinkComputers.UserHome"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:JamLinkComputers"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserHome">
    <!--inspo from :-->
    <!--https://www.youtube.com/watch?v=c7GRu6X1zWg&t=40s-->
    

    <Grid Background="{StaticResource JamLinkBackgroundBrush}">

        <!-- Main content -->
        <TextBlock 
               FontSize="28"
               FontWeight="Medium"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay"
          Background="#80000000"
          Visibility="Visible">

            <Border Width="240"
        Padding="24"
        Background="Black"
        CornerRadius="16"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Opacity="0.7">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="Loading..."
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                    <ProgressBar Width="160"
                             Height="10"
                             Foreground="#7C3AED"
                             IsIndeterminate="True" ValueChanged="ProgressBar_ValueChanged"/>
                </StackPanel>

            </Border>
        </Grid>
    </Grid>
</Page>
