<Page x:Class="JamLinkComputers.Pages.AIChatView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:JamLinkComputers.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AIChatView">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            
            <RowDefinition Height="Auto" />
           
        </Grid.RowDefinitions>

  
        <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ChatItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Margin="5" Padding="10" 
                            Background="{Binding BackgroundColor}" HorizontalAlignment="{Binding Alignment}">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="400"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- שורת הקלט -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" >
            <TextBox x:Name="TxtUserInput" Width="500" FontSize="16" VerticalAlignment="Center" 
                 KeyDown="TxtUserInput_KeyDown"/>
            <Button x:Name="BtnSend" Content="שלח" Width="80"  
                Click="BtnSend_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Page>
