<Page x:Class="JamLinkComputers.Pages.GroupDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:JamLinkComputers.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GroupDetailsPage">

    <Page.Resources>
        <local:RoleConverter x:Key="RoleConverter"/>
    </Page.Resources>

    <Grid Background="#0A192F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="25,20" Background="#112240" CornerRadius="0,0,25,25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.4" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button Content="←" Click="Back_Click" Background="Transparent" Foreground="#F1C40F" 
                    BorderThickness="0" FontSize="26" Cursor="Hand" Margin="0,0,20,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="GroupNameTitle" Text="LOADING..." Foreground="#F1C40F" 
                       FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <ItemsControl x:Name="MembersList" Margin="25,15">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#172A45" CornerRadius="15" Padding="18" Margin="0,0,0,15" 
            BorderBrush="#30363D" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" Color="Black"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="50" Height="50" Background="#6C5CE7" CornerRadius="25">
                                    <TextBlock Text="{Binding Username[0]}" Foreground="White" 
                           FontSize="22" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                                    <TextBlock Text="{Binding Username}" Foreground="White" 
                           FontSize="19" FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding Id, Converter={StaticResource RoleConverter}}" 
                           FontSize="13" Foreground="#8892B0" FontWeight="Medium"/>
                                </StackPanel>

                                <Border Grid.Column="2" Padding="14,7" CornerRadius="10" VerticalAlignment="Center" BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#112240"/>
                                            <Setter Property="BorderBrush" Value="#8892B0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Id, Converter={StaticResource RoleConverter}}" Value="Musician">
                                                    <Setter Property="BorderBrush" Value="#00BBFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Id, Converter={StaticResource RoleConverter}}" Value="Producer">
                                                    <Setter Property="BorderBrush" Value="#F1C40F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Id, Converter={StaticResource RoleConverter}}" Value="Musician &amp; Producer">
                                                    <Setter Property="BorderBrush" Value="#A29BFE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock FontWeight="ExtraBold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Id, Converter={StaticResource RoleConverter}}"/>
                                                <Setter Property="Foreground" Value="#8892B0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Id, Converter={StaticResource RoleConverter}}" Value="Musician">
                                                        <Setter Property="Foreground" Value="#00BBFF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Id, Converter={StaticResource RoleConverter}}" Value="Producer">
                                                        <Setter Property="Foreground" Value="#F1C40F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Id, Converter={StaticResource RoleConverter}}" Value="Musician &amp; Producer">
                                                        <Setter Property="Foreground" Value="#A29BFE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
