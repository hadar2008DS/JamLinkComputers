    <Grid>
        <Grid.ColumnDefinitions>
            
            <ColumnDefinition Width="Auto"/>
            
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SideBar"
                Grid.Column="0"
                Width="90"
                Background="#F4F5F9"
                Padding="8"
                MouseEnter="SideBar_MouseEnter"
                MouseLeave="SideBar_MouseLeave">

            <StackPanel>
                <uc:SideBarBTN x:Name="SideBarBTN" />

                <!--<Button Content="Home" Height="36" Click="Home_Click"/>
                <Button Content="Profile" Height="36" Click="Profile_Click"/>
                <Button Content="Groups" Height="36" Click="Groups_Click"/>-->
                <Button x:Name="MusicianButton"
                        Content="Upload Segment"
                        Height="36"
                        Visibility="Collapsed"
                        Click="MusicianBtn_Click"/>
                <Button x:Name="ProducerButton"
                        Content="Create Project"
                        Height="36"
                        Visibility="Collapsed"
                        Click="ProducerBtn_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Border x:Name="HomePanel"
                    Background="White"
                    CornerRadius="12"
                    Padding="24"
                    Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="Home" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Quick actions and updates will appear here."
                               Foreground="#666"/>
                </StackPanel>
            </Border>

            <Border x:Name="ProfilePanel"
                    Background="White"
                    CornerRadius="12"
                    Padding="24"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Profile" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Edit your personal information here."
                               Foreground="#666"/>
                </StackPanel>
            </Border>

            <Border x:Name="GroupsPanel"
                    Background="White"
                    CornerRadius="12"
                    Padding="24"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Groups" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Your collaborations and groups."
                               Foreground="#666"/>
                </StackPanel>
            </Border>

            <Border x:Name="MusicianPanel"
                    Background="White"
                    CornerRadius="12"
                    Padding="24"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Upload Segment" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Upload and manage your musical segments."
                               Foreground="#666"/>
                </StackPanel>
            </Border>

            <Border x:Name="ProducerPanel"
                    Background="White"
                    CornerRadius="12"
                    Padding="24"
                    Visibility="Collapsed">
