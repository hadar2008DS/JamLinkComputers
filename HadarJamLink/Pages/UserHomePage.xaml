<Page xmlns:uc="clr-namespace:JamLinkComputers.UControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="JamLinkComputers.UserHomePage"
      av:DesignHeight="250" av:DesignWidth="490"
      >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SideBar"
                Grid.Column="0"
                Width="120"
                Background="#F4F5F9"
                Padding="8">
            <StackPanel>
                <uc:SideBarBTN x:Name="SideBarBTN" Loaded="SideBarBTN_Loaded" />
                <Button x:Name="MusicianButton"
                        Content="Upload Segment"
                        Height="36"
                        Visibility="Collapsed"
                        />
                <Button x:Name="ProducerButton"
                        Content="Create Project"
                        Height="36"
                        Visibility="Collapsed"
                        />
            </StackPanel>
        </Border>

        <!-- Host area for dynamic UserControls -->
        <ContentControl x:Name="MainContent"
                        Grid.Column="1"
                        Background="Transparent" />
    </Grid>
</Page>

