<Page xmlns:uc="clr-namespace:JamLinkComputers.UControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="JamLinkComputers.UserHomePage"
      av:DesignHeight="350" av:DesignWidth="590"
      >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <!-- Sidebar column רחבה מספיק -->
            <ColumnDefinition x:Name="SideBarColumn" Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border x:Name="SideBar"
            Grid.RowSpan="2"
            Grid.Column="0"
            Background="#112240"
            Padding="8"
            VerticalAlignment="Stretch">

            <StackPanel Orientation="Vertical">
                <!-- Sidebar buttons -->
                <uc:SideBarBTN x:Name="SideBarBTN" Loaded="SideBarBTN_Loaded"/>
                <uc:TopToolsBar x:Name="TopToolsBar" Grid.Row="0" Grid.Column="1"/>

                <Button x:Name="MusicianButton"
                    Content="Upload Segment"
                    Height="36"
                    Visibility="Collapsed"/>

                <Button x:Name="ProducerButton"
                    Content="Create Project"
                    Height="36"
                    Visibility="Collapsed"/>

                <!-- Mute control added to the bottom of the sidebar -->
                <Grid Background="#0A192F" Width="52" HorizontalAlignment="Left" Margin="0,10,0,0" Height="38">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="1" Margin="10,20,10,10">
                    </StackPanel>

                    <Button x:Name="MuteButton" 
                            Grid.Row="2" 
                            Click="MuteButton_Click"
                            Background="Transparent" 
                            BorderThickness="0" 
                            Margin="0,0,0,30" 
                            HorizontalAlignment="Center" 
                            Cursor="Hand"
                            ToolTip="Mute/Unmute Audio">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="MuteIcon" Text="🔊" Foreground="#00D2FF" FontSize="24" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= TOP TABS ================= -->
        <TabControl Grid.Row="0"
                Grid.Column="1"
                Height="50"
                Background="#1A1A2E"
                    >
            <TabItem Header=" Tools" FontFamily="{StaticResource OswaldFont}">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="Tuner" Style="{StaticResource ToolButtonStyle}" Click="Tuner_Click"/>
                    <Button Content="Scales" Style="{StaticResource ToolButtonStyle}" Click="Scales_Click"/>
                    <Button Content="Chords" Style="{StaticResource ToolButtonStyle}" Click="Chords_Click"/>
                    <Button Content="Metronome" Style="{StaticResource ToolButtonStyle}" Click="Metronome_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Help" FontFamily="{StaticResource OswaldFont}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Tips" Style="{StaticResource ToolButtonStyle}" Click="Tips_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>



        <!-- ================= MAIN CONTENT ================= -->
        <ContentControl x:Name="MainContent"
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="Transparent"/>
    </Grid>
</Page>

