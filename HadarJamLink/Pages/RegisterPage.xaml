<Page x:Class="JamLinkComputers.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:JamLinkComputers"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage">

    <Grid Background="{StaticResource JamLinkBackgroundBrush}">
        <!-- inner transparent overlay so the background image is visible -->
        <Grid Background="Transparent">
            <Border Width="340"
                    Padding="36"
                    Background="White"
                    CornerRadius="24"
                    BorderBrush="#7C3AED"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="JamLink - Register"
                               FontFamily="{StaticResource OswaldFont}"
                               FontSize="28"
                               Foreground="#7C3AED"
                               HorizontalAlignment="Center"/>

                    <!-- Username -->
                    <TextBlock Text="Username"
                               FontWeight="SemiBold"
                        FontFamily="{StaticResource OswaldFont}"/>
                    <TextBox x:Name="usernameBox"
                             Height="40"
                             FontFamily="{StaticResource OswaldFont}"
                             BorderBrush="#7C3AED"
                             ToolTip="Username"/>
                    <TextBlock x:Name="usernameError" Foreground="Red" FontSize="12" />

                    <!-- Password -->
                    <TextBlock Text="Password"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource OswaldFont}"
                                />
                    <PasswordBox x:Name="passwordBox"
                                 Height="40"
                                 FontFamily="{StaticResource OswaldFont}"
                                 BorderBrush="#7C3AED"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBox x:Name="passwordTextBox"
                             Height="40"
                             Visibility="Collapsed"
                             TextChanged="PasswordTextBox_TextChanged"/>
                    <CheckBox x:Name="showPasswordCheck"
                              Content="Show password"
                              Checked="ShowPasswordCheck_Checked"
                              Unchecked="ShowPasswordCheck_Unchecked" />
                    <TextBlock x:Name="passwordError" Foreground="Red" FontSize="12" />

                    <!-- User Type -->
                    <ComboBox x:Name="userTypeCombo" Height="40">
                        <ComboBoxItem Content="Musician" IsSelected="True"/>
                        <ComboBoxItem Content="Producer"/>
                    </ComboBox>

                    <Button x:Name="registerButton"
                            Content="Register"
                            Height="42"
                            Background="#7C3AED"
                            Foreground="White"
                            BorderThickness="0"
                            Click="RegisterButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>