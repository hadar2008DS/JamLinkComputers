<Page x:Class="JamLinkComputers.Pages.SplashScreenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:JamLinkComputers.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SplashScreenPage">

    <Page.Resources>
        <Storyboard x:Key="WaveformAnimation">

            <DoubleAnimation Storyboard.TargetName="Line1" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.0">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase Oscillations="1" Springiness="6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="Line2" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase Oscillations="1" Springiness="6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="Line3" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase Oscillations="1" Springiness="6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="Line4" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase Oscillations="1" Springiness="6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="Line5" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase Oscillations="1" Springiness="6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="LogoText" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.8"/>

            <DoubleAnimation Storyboard.TargetName="LogoText" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                             From="20" To="0" Duration="0:0:0.6" BeginTime="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <PowerEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard Storyboard="{StaticResource WaveformAnimation}"/>
        </EventTrigger>
    </Page.Triggers>

    <Grid Background="#0A192F">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <Frame x:Name="MainFrame" 
           NavigationUIVisibility="Hidden"
           Background="Transparent" />
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="100">
                <StackPanel.Resources>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#0A5F7A"/>
                        <Setter Property="Width" Value="8"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleY="0"/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <Border x:Name="Line1" Height="30"/>
                <Border x:Name="Line2" Height="60"/>
                <Border x:Name="Line3" Height="90"/>
                <Border x:Name="Line4" Height="50"/>
                <Border x:Name="Line5" Height="70"/>
            </StackPanel>

            <TextBlock x:Name="LogoText" 
                       Text="JamLink" 
                       Foreground="#F1C40F" 
                       FontSize="42" 
                       FontWeight="Bold" 
                       Opacity="0"
                       HorizontalAlignment="Center" 
                       Margin="0,30,0,0">
                <TextBlock.RenderTransform>
                    <TranslateTransform Y="0"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock Text="Connect. Create. Jam." 
                       Foreground="White" 
                       Opacity="0.5" 
                       FontSize="14" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>
