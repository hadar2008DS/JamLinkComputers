<UserControl x:Class="JamLinkComputers.UControl.HomeV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="White">
            <StackPanel x:Name="ActivityFeedPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
        </ScrollViewer>

        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Padding="10,5">
                    <TextBlock x:Name="StatsLabel" Text="Your Stats" FontFamily="{StaticResource OswaldFont}" FontSize="16"/>
                </Border>
                <Canvas x:Name="StatsCanvas" Height="250">
                    <Path x:Name="GraphPath" Stroke="#6A309D" StrokeThickness="3"/>

                    <Button x:Name="ExploreButton" Content="Explore Musicians 🔍" 
                        Canvas.Right="20" Canvas.Top="-35"
                        Padding="10,5" Background="#6A309D" Foreground="White" 
                        FontWeight="Bold" Cursor="Hand" Click="ExploreButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="15"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Canvas>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

