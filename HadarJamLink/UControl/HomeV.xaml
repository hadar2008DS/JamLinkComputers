<UserControl x:Class="JamLinkComputers.UControl.HomeV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" 
              Style="{StaticResource ModernScrollViewer}" 
              HorizontalScrollBarVisibility="Auto" 
              VerticalScrollBarVisibility="Disabled" 
              Background="#112240">

            <StackPanel x:Name="ActivityFeedPanel" 
                Orientation="Horizontal" 
                VerticalAlignment="Center" 
                Margin="10,5"/>
        </ScrollViewer>

        <Grid Grid.Row="1" Background="#112240">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
           
           

            <Grid Grid.Column="0" Margin="10">
                <StackPanel>
                    <Border BorderBrush="#3C205E" BorderThickness="1" HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,10">
                        <TextBlock x:Name="StatsLabel" Text="Your Stats" Foreground="White" FontFamily="{StaticResource OswaldFont}" FontSize="16" />
                    </Border>

                    <Grid Background="#112240">
                        <Canvas x:Name="StatsCanvas" Height="250">
                            <Path x:Name="GraphPath" Stroke="#6A309D" StrokeThickness="3"/>
                        </Canvas>

                        <Button x:Name="ExploreButton" Content="Explore Partners 🔍" 
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-45,20,0"
                            Padding="10,5" Background="#6A309D" Foreground="White" 
                            FontWeight="Bold" Cursor="Hand" Click="ExploreButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="15"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

