<UserControl x:Class="JamLinkComputers.UControl.SideBarBTN"
             xmlns:uc="clr-namespace:JamLinkComputers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border x:Name="SideBar"
        HorizontalAlignment="Left"
        Height="380"
        MaxWidth="100"
        Background="#0F172A"
        Padding="12"
        CornerRadius="0,20,20,0"
        MouseEnter="SideBar_MouseEnter"
        MouseLeave="SideBar_MouseLeave" >

            <StackPanel>

                <!-- Logo / Title -->
                <TextBlock x:Name="WelcomeText"
                       Text="JamLink"
                       Foreground="White"
                       FontSize="18"
                       FontFamily="{StaticResource OswaldFont}"
                       FontWeight="SemiBold"
                       Opacity="0"
                       />


                <!-- Menu Buttons -->
                <Button Style="{StaticResource SideBarButton}"
                    Content="Home"
                    Click="Home_Click"/>

                <Button Style="{StaticResource SideBarButton}"
                    Content="Profile"
                    Click="Profile_Click"/>

                <Button Style="{StaticResource SideBarButton}"
                    Content="Groups"
                    Click="Groups_Click"/>

                <Separator/>

                <Button x:Name="MusicianButton"
                    Style="{StaticResource SideBarButton}"
                    Content="Upload Segment"
                    Visibility="Collapsed"
                    Click="Musician_Click"/>

                <Button x:Name="ProducerButton"
                    Style="{StaticResource SideBarButton}"
                    Content="Create Project"
                    Visibility="Collapsed"
                    Click="Producer_Click"/>

                <Button Style="{StaticResource SideBarButton}"
                Content="Explore"
                Click="Explore_Click"/>

            </StackPanel>
        </Border>
    </Grid>

</UserControl>
