<UserControl x:Class="JamLinkComputers.UControl.ProducerV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="SegmentModule" TargetType="Border">
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#222"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppLaunchButton" TargetType="Button">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!--<Template.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Template.Value>-->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Orange"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Top">
            <TextBlock Text="PRODUCER V" Foreground="Orange" FontSize="32" FontWeight="Black"/>
            <TextBlock Text="SYSTEM OPERATIONAL" Foreground="#00FF00" FontSize="10"  Opacity="0.7"/>

            <TextBlock Text="PROJECTS" Foreground="Gray" FontWeight="Bold" />
            <!--<ListBox Background="Transparent" BorderThickness="0" Foreground="White" Margin="0,10">
                <ListBoxItem Content="🎬 Neon_Drift_MusicVideo"/>
                <ListBoxItem Content="🔊 Bassline_Session_v4"/>
                <ListBoxItem Content="📱 TikTok_Vertical_Batch"/>
            </ListBox>-->
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden">
            <WrapPanel x:Name="SegmentsPanel">

                <Border Style="{StaticResource SegmentModule}" Width="380">
                    <StackPanel >
                        <TextBlock Text="THE FOUNDRY [AUDIO]" Foreground="Cyan" FontWeight="Bold" />
                        <Button Content="Launch Ableton Live" Style="{StaticResource AppLaunchButton}" Tag="ableton.exe" Click="LaunchApp_Click"/>
                        <Button Content="Launch FL Studio" Style="{StaticResource AppLaunchButton}" Tag="FL64.exe" Click="LaunchApp_Click"/>
                        <Button Content="Logic Pro (Remote)" Style="{StaticResource AppLaunchButton}"/>
                        <TextBlock Text="Current BPM: 128" Foreground="#444" FontSize="10" />
                    </StackPanel>
                </Border>

               

                <Border Style="{StaticResource SegmentModule}" Width="780">
                    <StackPanel >
                        <TextBlock Text="THE TERMINAL [DISTRO]" Foreground="MediumPurple" FontWeight="Bold" />
                        <UniformGrid Columns="3">
                            <Button Content="YouTube Studio" Style="{StaticResource AppLaunchButton}"  Tag="https://studio.youtube.com" Click="LaunchUrl_Click"/>
                            <Button Content="TikTok Center" Style="{StaticResource AppLaunchButton}" Tag="https://tiktok.com" Click="LaunchUrl_Click"/>
                            <Button Content="Discord Community" Style="{StaticResource AppLaunchButton}" Tag="discord.exe" Click="LaunchApp_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
