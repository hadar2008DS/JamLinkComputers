<UserControl x:Class="JamLinkComputers.UControl.ProducerV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <StackPanel>

            <TextBlock Text="Producer Area"
                   FontSize="22"
                   FontWeight="Bold"/>

            <!-- Create project -->
            <Button Content="Create New Project"
                Click="CreateProject_Click"/>
            <ListBox x:Name="AppsList"
                        DisplayMemberPath="AppName"/>
            <ListBox x:Name="MusicalSegments"
                        DisplayMemberPath="SegmentName"/>
        </StackPanel>

    </Grid>
</UserControl>
