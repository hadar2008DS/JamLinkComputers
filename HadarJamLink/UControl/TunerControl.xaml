<UserControl x:Class="JamLinkComputers.UControl.TunerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White" >
    <Grid>

        <ComboBox x:Name="InstrumentSelector" Width="120" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" 
              SelectedIndex="0" SelectionChanged="InstrumentSelector_SelectionChanged">
            <ComboBoxItem Content="Select Instrument"/>
            <ComboBoxItem Content="Guitar"/>
            <ComboBoxItem Content="Bass"/>
            <ComboBoxItem Content="Ukelele"/>
        </ComboBox>
        <!-- עיגול מרכזי -->
        <Ellipse Width="150" Height="150" Stroke="Black" StrokeThickness="3"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- תו מרכזי -->
        <TextBlock x:Name="NoteText" FontSize="48" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- חץ -->
        <Polygon x:Name="TuningArrow" Points="0,0 20,0 10,-30"
                 Fill="Red"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,1"/>
    </Grid>
</UserControl>
