<UserControl x:Class="JamLinkComputers.UControl.GroupsV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#3C205E">
    <UserControl.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <Style TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder" Padding="15,5" Margin="0,0,2,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0">
                                <ContentPresenter ContentSource="Header" TextBlock.Foreground="White" TextBlock.FontWeight="Bold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="DarkSlateBlue"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="DarkSlateBlue"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </UserControl.Resources>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="#F1C40F" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="👥" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="GROUPS" Foreground="#F1C40F" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#0D1117" BorderBrush="#00BBFF" BorderThickness="1">
                <Grid Height="30">
                    <TextBlock Text="Search groups..." Foreground="#444" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVis}}"/>
                    <TextBox x:Name="SearchBox" Background="Transparent" Foreground="White" BorderThickness="0" 
                         VerticalContentAlignment="Center" Padding="10,0" TextChanged="SearchBox_TextChanged" CaretBrush="White"/>
                </Grid>
            </Border>

            <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                <TabItem Header="MY GROUPS">
                    <ListBox x:Name="MyGroupsListBox" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                            <Border Background="#0D1117" BorderBrush="#3C205E" BorderThickness="1" Padding="10" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Group.GroupName}" 
                                       Foreground="#F1C40F" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       Cursor="Hand"
                                       VerticalAlignment="Center"
                                       MouseLeftButtonUp="GroupName_MouseLeftButtonUp" 
                                       TextDecorations="Underline"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Update" Click="UpdateGroup_Click" Width="70" Height="25" Background="#34495E" Foreground="White" BorderThickness="0"/>
                                        <Button Content="Leave" Click="LeaveGroup_Click" Width="70" Height="25" Background="#C0392B" Foreground="White" BorderThickness="0"/>
                                    </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <TabItem Header="AVAILABLE TO JOIN">
                    <ListBox x:Name="AvailableGroupsListBox" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0D1117" BorderBrush="#00BBFF" BorderThickness="1"  Padding="10" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding GroupName}" Foreground="White" VerticalAlignment="Center" FontSize="14"/>
                                    <Button Grid.Column="1" Content="Join" Click="JoinGroup_Click" Width="80" Height="25" Background="#F1C40F" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>
        </Grid>
    </UserControl>
