<UserControl x:Class="JamLinkComputers.UControl.GroupsV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="20">
            <TextBox x:Name="SearchBox" Width="250" Height="35" VerticalContentAlignment="Center" 
                 Padding="10,0" TextChanged="SearchBox_TextChanged" />
            <Button Content="Create New Group" Width="140" Height="35"  
                Click="CreateGroup_Click" Background="#6C63FF" Foreground="White"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="My Groups">
                <ListBox x:Name="MyGroupsListBox" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding GroupName}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding CreationDate, StringFormat='Joined: {0:dd/MM/yyyy}'}" Foreground="Gray"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Edit" Width="60" Click="EditGroup_Click" Tag="{Binding}"/>
                                        <Button Content="Leave" Width="60" Background="#FF6B6B" Foreground="White" Click="LeaveGroup_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="All Groups">
                <ListBox x:Name="AllGroupsListBox" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" Margin="10,5" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding GroupName}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding CreationDate, StringFormat='Created: {0:dd/MM/yyyy}'}" Foreground="Gray"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Join" Width="80" Click="JoinGroup_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
