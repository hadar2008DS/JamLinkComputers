<UserControl x:Class="JamLinkComputers.UControl.GroupsV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#6A1B9A" Padding="15">
            <TextBlock Text="Groups"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>
        </Border>

        <!-- Search Bar -->
        <Border Grid.Row="1"
            Background="#F3E5F5"
            Padding="10">
            <TextBox x:Name="SearchBox"
                 Height="30"
                 Width="200"
                 HorizontalAlignment="Right"
                 FontSize="14"
                 VerticalContentAlignment="Center"
                 TextChanged="SearchBox_TextChanged"
                 ToolTip="Search groups by name"
                 Text="Search group..." />
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1"
                Background="Transparent"
                BorderThickness="0">

            <!-- My Groups -->
            <TabItem Header="My Groups" Padding="10">
                <ListBox x:Name="MyGroupsListBox"
                     BorderThickness="0"
                     Background="Transparent">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                Margin="5"
                                Padding="10"
                                CornerRadius="8">

                                <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                    <!-- Group Name -->
                                    <TextBox Text="{Binding Group.GroupName}"
                                         Width="200"
                                         Margin="5"/>

                                    <!-- Update -->
                                    <Button Content="עדכן שם"
                                        Margin="5"
                                        Padding="6,4"
                                        Background="#9C27B0"
                                        Foreground="White"
                                        Click="UpdateGroup_Click"/>

                                    <!-- Leave -->
                                    <Button Content="עזוב קבוצה"
                                        Margin="5"
                                        Padding="6,4"
                                        Background="#E91E63"
                                        Foreground="White"
                                        Click="LeaveGroup_Click"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </TabItem>

            <!-- Available Groups -->
            <TabItem Header="Available Groups" Padding="10">
                <ListBox x:Name="AvailableGroupsListBox"
                     BorderThickness="0"
                     Background="Transparent">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                Margin="5"
                                Padding="10"
                                CornerRadius="8">

                                <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                    <!-- Group Name -->
                                    <TextBlock Text="{Binding GroupName}"
                                           Width="200"
                                           VerticalAlignment="Center"/>

                                    <!-- Join -->
                                    <Button Content="הצטרף"
                                        Padding="10,5"
                                        Background="#6A1B9A"
                                        Foreground="White"
                                        Click="JoinGroup_Click"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
