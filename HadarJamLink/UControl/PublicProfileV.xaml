<UserControl x:Class="JamLinkComputers.UControl.PublicProfileV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">

                <Button Content="← Back to Explore" Click="Back_Click" 
                        HorizontalAlignment="Left" Background="Transparent" 
                        Foreground="#8892B0" BorderThickness="0" Cursor="Hand" Margin="0,0,0,20"/>

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,40">
                    <Grid>
                        <Ellipse Width="120" Height="120" Fill="#112240" Stroke="#00D2FF" StrokeThickness="2"/>
                        <TextBlock Text="👤" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="UserNameTitle" Foreground="White" FontSize="36" 
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,5"/>
                    <TextBlock Text="Community Member" Foreground="#00D2FF" FontSize="14" 
                               HorizontalAlignment="Center" FontStyle="Italic"/>
                </StackPanel>

                <UniformGrid Columns="2" Margin="0,0,0,30">
                    <Border Background="#112240" CornerRadius="15" Padding="20" Margin="10">
                        <StackPanel>
                            <TextBlock Text="Instruments" Foreground="#FFD55F" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="InstrumentsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding InstrumentName}" Foreground="White" FontSize="14" Margin="0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="#112240" CornerRadius="15" Padding="20" Margin="10">
                        <StackPanel>
                            <TextBlock Text="Music Genres" Foreground="#00D2FF" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="GenresItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0A192F" CornerRadius="10" Padding="8,3" Margin="0,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding}" Foreground="#8892B0" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Public Musical Segments" Foreground="White" FontSize="22" FontWeight="Bold" Margin="10,0,0,15"/>
                <ItemsControl x:Name="SegmentsItemsControl" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#112240" Margin="0,5" Padding="15" CornerRadius="10">
                                <DockPanel>
                                    <TextBlock Text="🎵" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SegmentName}" Foreground="White" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding Genre}" Foreground="#8892B0" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Bpm, StringFormat={}{0} BPM}" Foreground="#FFD55F" 
                                      VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
