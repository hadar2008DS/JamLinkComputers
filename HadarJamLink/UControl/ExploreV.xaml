<UserControl x:Class="JamLinkComputers.UControl.ExploreV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="FilterTabStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="BackgroundBorder" 
                        Background="#FF112240" 
                        CornerRadius="8" 
                        Padding="15,8" 
                        BorderBrush="#1D2D50" 
                        BorderThickness="1"
                        Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#8892B0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#6A309D"/>
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#00D2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20" Background="#0A192F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Content="← Back to Dashboard" Click="Back_Click" 
                HorizontalAlignment="Left" Background="Transparent" 
                Foreground="#8892B0" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"/>
            <TextBlock Text="Explore Community" Foreground="White" FontSize="32" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <Border Background="#112240" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock Text="🔍" Foreground="#8892B0" FontSize="18" VerticalAlignment="Center" Margin="5,0,10,0"/>
                    <TextBox x:Name="SearchBox" Background="Transparent" Foreground="White" BorderThickness="0" 
                         FontSize="16" VerticalContentAlignment="Center" TextChanged="FilterUsers"/>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AllFilter" Content="All" IsChecked="True" Checked="FilterUsers"
                         Style="{StaticResource FilterTabStyle}"/>
                <RadioButton x:Name="MusicianFilter" Content="Musicians" Checked="FilterUsers"
                         Style="{StaticResource FilterTabStyle}" Margin="15,0,0,0"/>
                <RadioButton x:Name="ProducerFilter" Content="Producers" Checked="FilterUsers"
                         Style="{StaticResource FilterTabStyle}" Margin="15,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="UsersCardsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#112240" Width="200" Height="220" Margin="10" CornerRadius="15" BorderBrush="#1D2D50" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <Ellipse Width="70" Height="70" Fill="#A29BFE" Margin="0,0,0,15"/>
                                <TextBlock Text="{Binding Username}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>

                                <TextBlock Text="Verified Artist" x:Name="RoleText" Foreground="#00D2FF" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                                <Button Content="View Profile" Click="ViewProfile_Click" Width="120" Height="30" 
                                    Background="#00D2FF" Foreground="White" FontWeight="Bold">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="15"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
