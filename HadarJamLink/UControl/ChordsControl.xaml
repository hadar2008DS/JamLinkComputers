        <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Piano Chords" Width="120" Margin="5" Click="NavigatePiano"/>
            <Button Content="Guitar Chords" Width="120" Margin="5" Click="NavigateGuitar"/>
            <Button Content="Ukulele Chords" Width="120" Margin="5" Click="NavigateUkulele"/>
        </StackPanel>

        <wv2:WebView2 x:Name="MyWebView" 
                      Grid.Row="1" 
                      Source="{Binding CurrentUrl}" 
                      NavigationStarting="MyWebView_NavigationStarting"
                      NavigationCompleted="MyWebView_NavigationCompleted" />
    </Grid>
