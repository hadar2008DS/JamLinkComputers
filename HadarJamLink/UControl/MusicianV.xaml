<UserControl x:Class="JamLinkComputers.UControl.MusicianV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#1A1A2E">
        <ScrollViewer>
            <StackPanel>

                <!-- 🎸 Instruments -->
                <TextBlock Text="🎸 Manage Instruments"
                       Foreground="#FFD700"
                       FontSize="20"
                       FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" >
                    <ComboBox x:Name="AllInstrumentsCombo"
                          Width="200"
                          DisplayMemberPath="InstrumentName"
                          Background="White"/>

                    <Button Content="Add"
                        Click="AddInstrument_Click"
                        
                        Width="80"/>
                </StackPanel>

                <ListBox x:Name="InstrumentsListBox"
                     Height="120"
                     Background="#16213E"
                     BorderBrush="#FFD700">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>

                                <Button Content="🗑"
                                    Width="40"
                                    Click="DeleteInstrument_Click"
                                    DockPanel.Dock="Right"/>

                                <TextBlock Text="{Binding Instruments.InstrumentName}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 🎵 Genres -->
                <TextBlock Text="🎵 Genres"
                       Foreground="#00D2FF"
                       FontSize="20"
                       FontWeight="Bold"
                       />

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="NewGenreTextBox"
                         Width="200"
                         Background="White"/>

                    <Button Content="Add Genre"
                        Click="AddGenre_Click"
                       
                        Width="100"/>
                </StackPanel>

                <ListBox x:Name="GenresListBox"
                     Height="100"
                     Background="#16213E"
                     BorderBrush="#00D2FF"
                     />

                <!-- 💻 Segments -->
                <TextBlock Text="💻 Segments"
                       Foreground="MediumPurple"
                       FontSize="20"
                       FontWeight="Bold"
                       />

                <DataGrid x:Name="SegmentsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Background="#16213E"
                      Foreground="White">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"
                            Binding="{Binding SegmentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        
                        <DataGridTextColumn Header="Length"
                         Binding="{Binding LengthInSeconds, Mode=TwoWay}" />

                        <DataGridTextColumn Header="BPM"
                            Binding="{Binding Bpm, Mode=TwoWay}" />

                        <DataGridTextColumn Header="Key"
                            Binding="{Binding Key, Mode=TwoWay}" />

                        <DataGridTextColumn Header="Mood"
                        Binding="{Binding Mood, Mode=TwoWay}" />

                        <DataGridTextColumn Header="Genre"
                            Binding="{Binding Genre, Mode=TwoWay}" />

                        <DataGridTextColumn Header="Link"
                        Binding="{Binding Link, Mode=TwoWay}" />

                        <DataGridTemplateColumn Header="Save">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="💾"
                                        Click="UpdateSegment_Click"
                                        Width="40"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
