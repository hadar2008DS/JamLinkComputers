<UserControl x:Class="JamLinkComputers.UControl.MusicianV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#1A1A2E">
        <ScrollViewer>
            <StackPanel >

                <!-- 🎸 INSTRUMENTS -->
                <TextBlock Text="🎸 Manage Instruments"
                       Foreground="#FFD700"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,10"/>

                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="AllInstrumentsCombo"
                          Width="200"
                          DisplayMemberPath="InstrumentName"
                          Background="#16213E"
                          Foreground="White"/>

                    <Button Content="Add"
                        Click="AddInstrument_Click"
                        Margin="10,0"
                        Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>

                <ListBox x:Name="InstrumentsListBox"
                     Height="120"
                     Background="#16213E"
                     BorderBrush="#FFD700">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button Content="🗑️"
                                    Click="DeleteInstrument_Click"
                                    DockPanel.Dock="Right"
                                    Background="Transparent"
                                    BorderThickness="0"/>

                                <TextBlock Text="{Binding InstrumentName}"
                                       Foreground="White"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 🎵 GENRES -->
                <TextBlock Text="🎵 Genres"
                       Foreground="#00D2FF"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,20,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="NewGenreTextBox"
                         Width="200"
                         Background="#16213E"
                         Foreground="White"/>

                    <Button Content="Add Genre"
                        Click="AddGenre_Click"
                        Margin="10,0"
                        Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>

                <ListBox x:Name="GenresListBox"
                     Height="100"
                     Background="#16213E"
                     BorderBrush="#00D2FF"/>

                <!-- 💻 SEGMENTS --><!--
                <TextBlock Text="💻 Producer Suite"
                       Foreground="#00D2FF"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,20,0,10"/>-->

                <DataGrid x:Name="SegmentsGrid"
                      AutoGenerateColumns="False"
                      Background="#16213E"
                      RowBackground="#1A1A2E"
                      Foreground="White"
                      CanUserAddRows="False">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Name"
                        Binding="{Binding SegmentName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                        <DataGridTextColumn Header="Length"
                        Binding="{Binding LengthInSeconds}" Width="70"/>

                        <DataGridTextColumn Header="BPM"
                        Binding="{Binding Bpm}" Width="60"/>

                        <DataGridTextColumn Header="Key"
                        Binding="{Binding Key}" Width="60"/>

                        <DataGridTextColumn Header="Mood"
                        Binding="{Binding Mood}" Width="100"/>

                        <DataGridTextColumn Header="Genre"
                        Binding="{Binding Genre}" Width="100"/>

                        <DataGridTextColumn Header="Link"
                        Binding="{Binding Link}" Width="150"/>

                        <DataGridTemplateColumn Header="Save">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="💾"
                                        Click="UpdateSegment_Click"
                                        Background="#FFD700"
                                        Foreground="Black"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
