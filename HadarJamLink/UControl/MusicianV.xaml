<UserControl x:Class="JamLinkComputers.UControl.MusicianV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#0A192F">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25">

                <Border Background="#112240" CornerRadius="20" Padding="20" Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🎸 My Instruments" Foreground="#F1C40F" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AllInstrumentsCombo" Height="40" Background="#1D2D50" Foreground="White" 
                                      DisplayMemberPath="InstrumentName" BorderThickness="1" BorderBrush="#30363D"/>
                            <Button Grid.Column="1" Content="Add New" Click="AddInstrument_Click" Width="100" Margin="10,0,0,0"
                                    Background="#F1C40F" Foreground="#0A192F" FontWeight="Bold">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <ItemsControl x:Name="InstrumentsListBox">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1D2D50" CornerRadius="12" Padding="12,6" Margin="0,0,10,10" BorderBrush="#00BBFF" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Instruments.InstrumentName, TargetNullValue='(No Instrument)', FallbackValue='...'}" 
                               Foreground="White" VerticalAlignment="Center" FontWeight="Medium"/>
                                            <Button Content="×" Click="DeleteInstrument_Click" Background="Transparent" Foreground="#FF4B2B" 
                            BorderThickness="0" FontSize="16" Margin="8,0,0,0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="#112240" CornerRadius="20" Padding="20" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="🎵 Genres Inspiration" Foreground="#00D2FF" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBox x:Name="NewGenreTextBox" Width="250" Height="35" Background="#1D2D50" Foreground="White" 
                                     BorderBrush="#30363D" Padding="10,5" VerticalContentAlignment="Center"/>
                            <Button Content="+ Add Genre" Click="AddGenre_Click" Width="120" Margin="10,0,0,0" Background="#00D2FF" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                        <ItemsControl x:Name="GenresListBox">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0A192F" CornerRadius="15" Padding="15,5" Margin="5" BorderBrush="#8892B0" BorderThickness="0.5">
                                        <TextBlock Text="{Binding}" Foreground="#8892B0" FontSize="13" FontStyle="Italic"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="💻 Musical Segments" Foreground="#A29BFE" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border Background="#112240" CornerRadius="15" Padding="10">
                    <DataGrid x:Name="SegmentsGrid" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" 
                              BorderThickness="0" Foreground="White" RowBackground="Transparent" GridLinesVisibility="None"
                              HeadersVisibility="Column" RowHeight="45">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#8892B0"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Width="*" Binding="{Binding SegmentName, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="BPM" Width="60" Binding="{Binding Bpm}"/>
                            <DataGridTextColumn Header="KEY" Width="60" Binding="{Binding Key}"/>
                            <DataGridTextColumn Header="GENRE" Width="100" Binding="{Binding Genre}"/>
                            <DataGridTemplateColumn Header="ACTION" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="💾 Save" Click="UpdateSegment_Click" Background="#27AE60" Foreground="White" Padding="8,2" FontSize="11" FontWeight="Bold">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="5"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
