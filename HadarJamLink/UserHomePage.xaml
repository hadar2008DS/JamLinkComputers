<Page x:Class="JamLinkComputers.UserHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      >

    <Grid Background="#FAFAFA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#F4F5F9"
                Padding="16">

            <StackPanel>

                <TextBlock x:Name="WelcomeText"
                           Text="Welcome"
                           FontSize="18"
                           FontWeight="SemiBold"/>

                <Separator/>

                <Button Style="{StaticResource NavButtonStyle}"
                        Content="Home"
                        Click="Home_Click"/>

                <Button Style="{StaticResource NavButtonStyle}"
                        Content="Profile"
                        Click="Profile_Click"/>

                <Button Style="{StaticResource NavButtonStyle}"
                        Content="Groups"
                        Click="Groups_Click"/>

                <Separator/>

                <Button x:Name="MusicianButton"
                        Style="{StaticResource NavButtonStyle}"
                        Content="Upload Segment"
                        Click="MusicianBtn_Click"
                        Visibility="Collapsed"/>

                <Button x:Name="ProducerButton"
                        Style="{StaticResource NavButtonStyle}"
                        Content="Create Project"
                        Click="ProducerBtn_Click"
                        Visibility="Collapsed"/>

            </StackPanel>
        </Border>

        <!-- Content area -->
        <Border Grid.Column="1"
                Padding="32">

            <Grid>

                <!-- Home -->
                <Border x:Name="HomePanel"
                        Background="White"
                        CornerRadius="12"
                        Padding="24"
                        Visibility="Visible">

                    <StackPanel>
                        <TextBlock Text="Home"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Quick actions and updates will appear here."
                                   Foreground="#666"/>
                    </StackPanel>
                </Border>

                <!-- Profile -->
                <Border x:Name="ProfilePanel"
                        Background="White"
                        CornerRadius="12"
                        Padding="24"
                        Visibility="Collapsed">

                    <StackPanel>
                        <TextBlock Text="Profile"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Edit your personal information here."
                                   Foreground="#666"/>
                    </StackPanel>
                </Border>

                <!-- Groups -->
                <Border x:Name="GroupsPanel"
                        Background="White"
                        CornerRadius="12"
                        Padding="24"
                        Visibility="Collapsed">

                    <StackPanel>
                        <TextBlock Text="Groups"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Your collaborations and groups."
                                   Foreground="#666"/>
                    </StackPanel>
                </Border>

                <!-- Musician -->
                <Border x:Name="MusicianPanel"
                        Background="White"
                        CornerRadius="12"
                        Padding="24"
                        Visibility="Collapsed">

                    <StackPanel>
                        <TextBlock Text="Upload Segment"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Upload and manage your musical segments."
                                   Foreground="#666"/>
                    </StackPanel>
                </Border>

                <!-- Producer -->
                <Border x:Name="ProducerPanel"
                        Background="White"
                        CornerRadius="12"
                        Padding="24"
                        Visibility="Collapsed">

                    <StackPanel>
                        <TextBlock Text="Create Project"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Start a new project and invite collaborators."
                                   Foreground="#666"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Page>

