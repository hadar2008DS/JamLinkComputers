<Application x:Class="HadarJamLink.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HadarJamLink"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="OswaldFont">pack://application:,,,/Assets/Fonts/Oswald[wght].ttf#Oswald</FontFamily>

        <!-- ImageBrush moved to application resources for reuse -->
        <ImageBrush x:Key="JamLinkBackgroundBrush"
                    ImageSource="pack://application:,,,/Assets/Images/JamLinkLogInUp.png"
                    Stretch="UniformToFill" />
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Application.Resources>
</Application>
