<UserControl x:Class="JamLinkComputers.UserControls.SideBarButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamLinkComputers.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border x:Name="SideBar"
            Width="85"
            Background="#F4F5F9"
            Padding="8"
            >

            <StackPanel>

                <TextBlock x:Name="WelcomeText"
                       Text="Welcome"
                       FontSize="16"
                       FontWeight="SemiBold"/>

                <Button Content="Home" Click="Home_Click"/>
                <Button Content="Profile" Click="Profile_Click"/>
                <Button Content="Groups" Click="Groups_Click"/>

                <Button x:Name="MusicianButton"
                    Content="Upload Segment"
                    Visibility="Collapsed"
                    Click="MusicianBtn_Click"/>

                <Button x:Name="ProducerButton"
                    Content="Create Project"
                    Visibility="Collapsed"
                    Click="ProducerBtn_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
